<mxfile host="drawio" version="24.0.0">
  <diagram id="subscriptions" name="Subscriptions architecture">
    <mxGraphModel dx="1400" dy="900" background="#ffffff" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="crystal-es subscriptions: event delivery across application instances, on Postgres alone" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1000" height="36" as="geometry" />
        </mxCell>

        <!-- Instance A -->
        <mxCell id="instA" value="Application instance A" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="440" height="400" as="geometry" />
        </mxCell>
        <mxCell id="A_cmd" value="Commands / API&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;command handlers append events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="A_runner" value="ES::Subscriptions" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="400" height="285" as="geometry" />
        </mxCell>
        <mxCell id="A_rebal" value="&lt;b&gt;Rebalance loop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;heartbeat · try_lock&lt;br&gt;takes ceil(subscriptions / instances)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="55" y="190" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="A_wake" value="&lt;b&gt;Wake loop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LISTEN (opt-in) and poll log_head&lt;br&gt;signals the subscriptions it holds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="250" y="190" width="175" height="60" as="geometry" />
        </mxCell>
        <mxCell id="A_r1" value="reactor:OnOrderPlaced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="290" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="A_p1" value="projection:Orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="290" width="175" height="45" as="geometry" />
        </mxCell>
        <mxCell id="A_note" value="Each box below is a subscription this instance holds (its lock), run by one fiber. Each reads from its own position, at its own pace; a failing one retries, then pauses, alone." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="55" y="345" width="370" height="40" as="geometry" />
        </mxCell>
        <mxCell id="A_api" value="configure · start · stop · status · pause · resume · skip_failed_event · rebuild · reset · await" style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#666666;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="55" y="390" width="370" height="40" as="geometry" />
        </mxCell>

        <!-- Instance B -->
        <mxCell id="instB" value="Application instance B" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="490" width="440" height="270" as="geometry" />
        </mxCell>
        <mxCell id="B_cmd" value="Commands / API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="525" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="B_runner" value="ES::Subscriptions" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="400" height="165" as="geometry" />
        </mxCell>
        <mxCell id="B_rebal" value="&lt;b&gt;Rebalance loop&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="55" y="610" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="B_wake" value="&lt;b&gt;Wake loop&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="250" y="610" width="175" height="40" as="geometry" />
        </mxCell>
        <mxCell id="B_r1" value="reactor:OnPaymentCaptured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="660" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="B_p1" value="projection:Invoices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="660" width="175" height="40" as="geometry" />
        </mxCell>
        <mxCell id="B_note" value="Appends, wakes up and takes locks exactly like A. Partitioned handlers (partitions: n) become n subscriptions, spread like any other." style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="55" y="705" width="370" height="35" as="geometry" />
        </mxCell>

        <!-- Event store database -->
        <mxCell id="esdb" value="Event store database (Postgres 13+)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="540" y="60" width="420" height="700" as="geometry" />
        </mxCell>
        <mxCell id="events" value="&lt;b&gt;eventstore.events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;id · header · body · &lt;b&gt;transaction_id xid8&lt;/b&gt; (default pg_current_xact_id())&lt;br&gt;index events_log_position_idx (transaction_id, id)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="95" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="trigger" value="&lt;b&gt;trigger notify_subscriptions&lt;/b&gt; (only with listen_url)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;NOTIFY crystal_es_events on commit; otherwise subscriptions poll&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="560" y="200" width="380" height="45" as="geometry" />
        </mxCell>
        <mxCell id="readlog" value="&lt;b&gt;read_log · log_head&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;events in transaction order, only up to pg_snapshot_xmin:&lt;br&gt;a late commit is never skipped&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="260" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subs" value="&lt;b&gt;eventstore.subscriptions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;name · position · status · attempts · last_error&lt;br&gt;reactor positions; projection positions mirrored for status&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="330" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="instances" value="&lt;b&gt;eventstore.subscription_instances&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one heartbeat per running instance&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="425" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="locks" value="&lt;b&gt;session advisory locks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one per subscription, held on a dedicated connection;&lt;br&gt;released by Postgres when an instance dies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="560" y="500" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tagversions" value="&lt;b&gt;eventstore.tag_versions&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(conditional appends)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="570" width="380" height="45" as="geometry" />
        </mxCell>
        <mxCell id="es_note" value="&lt;b&gt;Reactor delivery = one transaction&lt;/b&gt;: the reactor's appends (through the store it is given, in savepoints) and the move of its position, compare-and-set from the last saved one. It commits once, or not at all: &lt;b&gt;exactly once&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="560" y="630" width="380" height="70" as="geometry" />
        </mxCell>

        <!-- Projection database -->
        <mxCell id="projdb" value="Projection database (Postgres, may be the same)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1040" y="60" width="360" height="370" as="geometry" />
        </mxCell>
        <mxCell id="ptables" value="&lt;b&gt;projection tables&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;e.g. shop.orders, billing.invoices&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1060" y="95" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pcheck" value="&lt;b&gt;&amp;lt;schema&amp;gt;._crystal_es_projection_checkpoints&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;position per projection subscription,&lt;br&gt;next to its rows&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1060" y="180" width="320" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p_note" value="&lt;b&gt;atomic: true&lt;/b&gt;: a batch of rows (written through &lt;font face=&quot;monospace&quot;&gt;write { |connection| ... }&lt;/font&gt;) and the position commit in one transaction: &lt;b&gt;exactly once&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Otherwise one event at a time, position saved after it: an event may apply twice after a crash." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1060" y="270" width="320" height="140" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Guarantees&lt;/b&gt;&lt;br&gt;• exactly one instance processes a subscription at a time&lt;br&gt;• append order per subscription (per aggregate when partitioned)&lt;br&gt;• new reactors start now; new projections start at the beginning&lt;br&gt;• failures: rollback, retry with backoff, pause after max_attempts&lt;br&gt;• positions move by compare-and-set, so a lost lock or a reset rolls work back instead of repeating it&lt;br&gt;&lt;br&gt;&lt;b&gt;Arrows&lt;/b&gt;&lt;br&gt;solid: reads and writes · dashed: wake-ups · red: coordination" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1040" y="460" width="360" height="300" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_append_a" value="append" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;strokeColor=#666666;" edge="1" parent="1" source="A_cmd" target="events">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="500" y="120" /><mxPoint x="500" y="140" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_notify_a" value="NOTIFY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;fontSize=10;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="trigger" target="A_wake">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="520" y="222" /><mxPoint x="520" y="200" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_read" value="read_log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;strokeColor=#6c8ebf;fontColor=#336699;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="A_p1" target="readlog">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="500" y="312" /><mxPoint x="500" y="295" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_react" value="transaction: reactor's appends + advance position" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;strokeColor=#d6b656;fontColor=#8a6d00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="A_r1" target="subs">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="sourcePoint" x="145" y="290" />
            <Array as="points"><mxPoint x="145" y="270" /><mxPoint x="520" y="270" /><mxPoint x="520" y="370" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_project" value="transaction: rows + advance checkpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;strokeColor=#82b366;fontColor=#3d7a32;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="B_p1" target="pcheck">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="sourcePoint" x="425" y="680" />
            <Array as="points"><mxPoint x="450" y="680" /><mxPoint x="450" y="785" /><mxPoint x="1005" y="785" /><mxPoint x="1005" y="217" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_lock_a" value="try_lock · heartbeat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;strokeColor=#b85450;fontColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="A_rebal" target="locks">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="30" y="220" /><mxPoint x="30" y="475" /><mxPoint x="510" y="475" /><mxPoint x="510" y="527" /></Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
