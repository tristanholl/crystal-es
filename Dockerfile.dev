#
# BASE artifact
#
FROM 84codes/crystal:1.20.2-ubuntu-24.04 AS base

#
# BUILDER artifact
#
FROM base AS builder

RUN mkdir -p /crystal-es/lib
WORKDIR /crystal-es/lib
COPY ./shard* /crystal-es/lib/

# RUN  crystal -v
RUN shards install

COPY ./ /crystal-es/lib

# Precompile the Ameba linter into ./bin so `make lint` is a plain binary run
# rather than a fresh compile on every invocation.
RUN shards build ameba

#
# SERVICE 
#
FROM builder AS service

ENV image_name=crystal-es

WORKDIR /crystal-es/lib
