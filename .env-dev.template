# Database configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Base64-encoded 32-byte application encryption key (the KEK for event payload
# encryption, see README.md#payload-encryption). Generate one with:
#   openssl rand -base64 32
# Must stay stable for the lifetime of the store — changing it makes every
# previously wrapped data key unreadable.
APPLICATION_ENCRYPTION_KEYS=
